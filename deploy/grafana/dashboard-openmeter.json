{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 20,
      "type": "stat",
      "title": "Wallet balance — ${subject}",
      "description": "Tokens left in the subject's OpenMeter entitlement, converted to USD at the opt-125m prompt list price ($0.0015 per token) so the top row reads in money.",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "openmeter"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": {"valueSize": 52, "titleSize": 14}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0.01}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/v1/customers/${subject}/entitlements/inference_tokens/value?model=",
          "url_options": {"method": "GET"},
          "root_selector": "",
          "columns": [
            {"selector": "balance", "text": "balance", "type": "number"}
          ]
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binaryOp",
            "binaryOperation": {"left": "balance", "operator": "*", "right": "0.0015"},
            "alias": "wallet_usd",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Spent — ${subject}",
      "description": "Tokens used in the current usage period, converted to USD at the opt-125m prompt list price ($0.0015 per token). Exact per-model spend is in the detail panels at the bottom.",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "openmeter"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": {"valueSize": 52, "titleSize": 14}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "fixed", "fixedColor": "orange"}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/v1/customers/${subject}/entitlements/inference_tokens/value?model=",
          "url_options": {"method": "GET"},
          "root_selector": "",
          "columns": [
            {"selector": "usage", "text": "usage", "type": "number"}
          ]
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binaryOp",
            "binaryOperation": {"left": "usage", "operator": "*", "right": "0.0015"},
            "alias": "spend_usd",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Admission Hook — ${subject}",
      "description": "Live answer from the external_metering ExtProc filter: hasAccess=true admits the request, hasAccess=false rejects it with the budget-exhausted error.",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "openmeter"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": {"valueSize": 52, "titleSize": 14},
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "true": {"text": "ADMIT", "color": "green", "index": 0},
                "false": {"text": "REJECT", "color": "red", "index": 1},
                "1": {"text": "ADMIT", "color": "green", "index": 2},
                "0": {"text": "REJECT", "color": "red", "index": 3}
              }
            }
          ],
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/v1/customers/${subject}/entitlements/inference_tokens/value?model=",
          "url_options": {"method": "GET"},
          "root_selector": "",
          "columns": [
            {"selector": "hasAccess", "text": "hasAccess", "type": "string"}
          ]
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Rate Card — plan inference_payg (USD per token)",
      "description": "Unit prices read live from the OpenMeter plan.",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "openmeter"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}, "unit": "currencyUSD", "decimals": 4},
        "overrides": []
      },
      "options": {"showHeader": true},
