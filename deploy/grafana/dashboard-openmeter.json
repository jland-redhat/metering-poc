          "url_options": {"method": "GET"},
          "root_selector": "phases.0.rateCards",
          "columns": [
            {"selector": "key", "text": "rate", "type": "string"},
            {"selector": "name", "text": "description", "type": "string"},
            {"selector": "price.amount", "text": "unit price", "type": "number"},
            {"selector": "price.type", "text": "type", "type": "string"},
            {"selector": "billingCadence", "text": "cadence", "type": "string"}
          ]
        }
      ]
    },
